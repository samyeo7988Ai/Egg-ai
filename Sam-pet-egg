<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width,
               initial-scale=1.0,
               maximum-scale=1.0,
               user-scalable=no">

<title>SAM 宠物蛋 V1.0</title>

<style>
*{
    box-sizing:border-box;
    -webkit-tap-highlight-color:transparent;
}

body{
    margin:0;
    min-height:100vh;
    background:
        radial-gradient(circle at top,#51408a 0%,#201a38 45%,#0f1020 100%);
    color:white;
    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Arial,
        sans-serif;
    display:flex;
    justify-content:center;
}

button{
    border:0;
    outline:0;
    color:white;
    font-size:16px;
    cursor:pointer;
}

.app{
    width:100%;
    max-width:480px;
    min-height:100vh;
    padding:18px 16px 30px;
    position:relative;
    overflow:hidden;
}

/* 顶部 */

.topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:15px;
}

.logo{
    font-size:24px;
    font-weight:900;
    color:#fff;
}

.version{
    font-size:11px;
    background:rgba(255,255,255,.12);
    padding:6px 10px;
    border-radius:20px;
}

/* 状态 */

.stats{
    display:grid;
    grid-template-columns:1fr 1fr 1fr;
    gap:8px;
    margin-bottom:16px;
}

.stat{
    background:rgba(255,255,255,.10);
    border:1px solid rgba(255,255,255,.08);
    border-radius:16px;
    padding:10px 8px;
    text-align:center;
    backdrop-filter:blur(10px);
}

.stat-icon{
    font-size:18px;
}

.stat-value{
    font-weight:800;
    margin-top:3px;
}

.stat-name{
    font-size:10px;
    opacity:.65;
}

/* 宠物区域 */

.pet-card{
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.17),
            rgba(255,255,255,.06)
        );

    border:1px solid rgba(255,255,255,.13);
    border-radius:28px;
    padding:20px 16px 18px;
    text-align:center;
    box-shadow:
        0 20px 50px rgba(0,0,0,.25);
}

.pet-title{
    font-size:15px;
    font-weight:800;
}

.pet-level{
    margin-top:5px;
    font-size:12px;
    opacity:.7;
}

/* 蛋 */

.egg-area{
    height:290px;
    display:flex;
    justify-content:center;
    align-items:center;
    position:relative;
}

.glow{
    position:absolute;
    width:190px;
    height:190px;
    border-radius:50%;
    background:rgba(180,150,255,.22);
    filter:blur(30px);
}

.egg{
    position:relative;
    width:145px;
    height:180px;

    background:
        linear-gradient(
            135deg,
            #fff9e9 0%,
            #e9d7b0 45%,
            #b99065 100%
        );

    border-radius:
        50% 50% 47% 47%
        / 58% 58% 42% 42%;

    box-shadow:
        inset -18px -15px 25px rgba(80,40,10,.16),
        inset 15px 12px 25px rgba(255,255,255,.6),
        0 15px 30px rgba(0,0,0,.35);

    animation:float 2.8s ease-in-out infinite;
}

.egg::before{
    content:"";
    position:absolute;
    width:35px;
    height:70px;
    left:27px;
    top:25px;
    border-radius:50%;
    background:rgba(255,255,255,.30);
    transform:rotate(18deg);
}

.egg-face{
    position:absolute;
    top:74px;
    left:0;
    width:100%;
    display:flex;
    justify-content:center;
    gap:35px;
}

.eye{
    width:12px;
    height:18px;
    border-radius:50%;
    background:#36243e;
}

.mouth{
    position:absolute;
    top:27px;
    width:17px;
    height:9px;
    border-bottom:3px solid #36243e;
    border-radius:50%;
}

.egg-hint{
    position:absolute;
    bottom:5px;
    font-size:12px;
    opacity:.65;
}

@keyframes float{
    0%,100%{
        transform:translateY(0) rotate(-1deg);
    }

    50%{
        transform:translateY(-10px) rotate(1deg);
    }
}

/* 孵化进度 */

.progress-title{
    display:flex;
    justify-content:space-between;
    font-size:11px;
    opacity:.75;
    margin-bottom:6px;
}

.progress{
    width:100%;
    height:10px;
    background:rgba(255,255,255,.12);
    border-radius:20px;
    overflow:hidden;
}

.progress-bar{
    height:100%;
    width:0%;
    background:
        linear-gradient(90deg,#ffcf70,#ff8bd8);
    border-radius:20px;
    transition:.4s;
}

/* 按钮 */

.actions{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:9px;
    margin-top:15px;
}

.action{
    min-height:76px;
    border-radius:19px;
    background:rgba(255,255,255,.10);
    border:1px solid rgba(255,255,255,.08);
    transition:.12s;
}

.action:active{
    transform:scale(.94);
    background:rgba(255,255,255,.18);
}

.action-icon{
    display:block;
    font-size:25px;
    margin-bottom:5px;
}

.action-name{
    font-size:12px;
}

/* 信息 */

.message{
    min-height:38px;
    margin-top:12px;
    text-align:center;
    font-size:13px;
    color:#ffe7a8;
}

/* 底部 */

.bottom{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:8px;
    margin-top:14px;
}

.bottom-btn{
    background:rgba(255,255,255,.08);
    border-radius:15px;
    padding:11px 5px;
    font-size:11px;
}

.bottom-bt
